def cmd_os(args):
    """List/search OpenSea candidates."""
    c = conn()
    sql = "SELECT * FROM opensea_candidates WHERE 1=1"
    params = []
    if args.query:
        sql += " AND (slug LIKE ? OR name LIKE ? OR contract LIKE ?)"
        p = f"%{args.query}%"
        params.extend([p, p, p])
    if args.status:
        sql += " AND status = ?"
        params.append(args.status)
    if args.nft_type:
        sql += " AND nft_type = ?"
        params.append(args.nft_type)
    if args.mint:
        sql += " AND mint_status = ?"
        params.append(args.mint)
    if args.no_image:
        sql += " AND (image_url IS NULL OR image_url = '')"
    sql += " ORDER BY slug"
    rows = [dict(r) for r in c.execute(sql, params)]
    c.close()

    if args.json:
        print(json.dumps(rows, indent=2, default=str))
        return
    if not rows:
        print("No OpenSea candidates found.")
        return

    hdr = f"{'Slug':<38} {'Name':<28} {'Released':<11} {'Chain':<8} {'VRM':<6} {'URL':<3} {'Soc':<3} {'Supply':<16} {'Type':<12}"
    print(hdr)
    print("-" * len(hdr))
    for r in rows:
        us = r.get('url_status', '') or ''
        ui = {'alive':'✓','dead':'✗','error':'?'}.get(us, '—')
        ds = r.get('discord_status', '') or ''
        di = {'alive':'✓','dead':'✗','rate_limited':'⏳','error':'?'}.get(ds, '—')
        ti = '𝕏' if r.get('twitter_username') else '—'
        soc = f"{di}{ti}"
        vrm = 'VRM' if r.get('vrm_url') or r.get('vrm_url_https') else '—'
        print(f"{truncate(r['slug'],38):<38} {truncate(r['name'] or r['slug'],28):<28} "
              f"{r.get('release_date') or '?':<11} {truncate(r.get('chain','?'),8):<8} {vrm:<6} {ui:<3} {soc:<3} "
              f"{fmt_supply(r):<16} {fmt_nft_type(r):<12}")
    print(f"\n{len(rows)} candidate(s)")

def cmd_avatars(args):
    """Search avatars."""
    c = conn()
    sql = "SELECT a.*, c.name as collection_name FROM avatars a LEFT JOIN collections c ON a.collection_id = c.id WHERE 1=1"
    params = []
    if args.query:
        sql += " AND (a.name LIKE ? OR a.collection_id LIKE ? OR a.model_file_url LIKE ?)"
        p = f"%{args.query}%"
        params.extend([p, p, p])
    sql += " ORDER BY a.collection_id, a.name"
    if not args.all:
        sql += " LIMIT 50"
    rows = [dict(r) for r in c.execute(sql, params)]
    c.close()

    if args.json:
        print(json.dumps(rows, indent=2, default=str))
        return
    if not rows:
        print("No avatars found.")
        return

    print(f"{'Collection':<28} {'Avatar':<30} {'Format':<8} {'URL'}")
    print("-" * 100)
    for a in rows:
        print(f"{truncate(a.get('collection_name',''),28):<28} {truncate(a.get('name',''),30):<30} "
              f"{a.get('format','') or '?':<8} {truncate(a.get('model_file_url',''),50)}")
    total = c.execute("SELECT COUNT(*) FROM avatars").fetchone()[0] if not args.all else len(rows)
    print(f"\n{len(rows)} avatar(s)" + (f" (showing first 50 of {total}, use --all for all)" if not args.all and len(rows) == 50 else ""))

