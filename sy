#!/usr/bin/env python3
"""superyeti — unified CLI for the VRM/3D avatar collection index.

Usage:
  sy                              list all collections (compact)
  sy ls                           same as above
  sy show <name>                  full detail for one collection
  sy find <query>                 search by name/contract/slug/creator
  sy find --tier A --chain base   filter by attributes
  sy os                           list OpenSea candidates
  sy os <query>                   search candidates
  sy avatars <query>              search avatars
  sy stats                        index statistics + data completeness
  sy audit                        find missing data (gaps)
  sy images                       check for broken image URLs
  sy images --fix                 re-fetch broken images from OpenSea
  sy enrich                       run all enrichment scripts
  sy enrich --only supply         run one enrichment script
  sy build                        rebuild DB + HTML from scratch
  sy db                           open sqlite3 shell
  sy schema                       print DB schema
  sy sql <query>                  run raw SQL, print as table
  sy sql --json <query>           run raw SQL, print as JSON

Shortcuts:
  sy -A          same as: sy find --tier A
  sy -B          same as: sy find --tier B
  sy -C          same as: sy find --tier C
  sy -g          same as: sy find --license green
  sy -d          same as: sy find --discord none   (no discord)
  sy -v          same as: sy find --nft-type generative
"""
import sqlite3, argparse, json, sys, os, subprocess, urllib.request, ssl, time
from pathlib import Path

BASE = Path(__file__).parent.resolve()
DB = BASE / "vrm_index.db"
KEY_FILE = Path(os.path.expanduser("~/.opensea/api_key"))

# ─── DB helpers ──────────────────────────────────────────────────────────────

def conn():
    c = sqlite3.connect(str(DB))
    c.row_factory = sqlite3.Row
    return c

def get_columns(table):
    c = conn()
    cols = [r[1] for r in c.execute(f"PRAGMA table_info({table})")]
    c.close()
    return cols

# ─── Display helpers ─────────────────────────────────────────────────────────

def truncate(s, n):
    s = str(s or '')
    return s[:n-1] + '…' if len(s) > n else s

def fmt_supply(c):
    ms = c.get('mint_status', '') or ''
    total = c.get('total_supply')
    max_s = c.get('max_supply')
    icons = {'capped':'🔒','likely_capped':'🔒~','ongoing':'🟢','no_max_supply':'❓','unknown':'?'}
    icon = icons.get(ms, '—')
    t = f"{total:,}" if total else '?'
    s = f"{icon} {t}"
    if max_s: s += f"/{max_s:,}"
    if ms == 'ongoing' and c.get('mint_progress'):
        s += f" ({c['mint_progress']}%)"
    return s

def fmt_nft_type(c):
    t = c.get('nft_type', 'unknown') or 'unknown'
    icons = {'generative':'🎲','1of1_series':'🎨','1of1_art':'🖼','numbered':'🔢',
             'no_traits':'∅','mixed':'🔀','unknown':'❓'}
    return f"{icons.get(t,'?')} {t}"

def fmt_license(c):
    lic = c.get('license_category', '') or ''
    return {'green':'🟢','yellow':'🟡','red':'🔴'}.get(lic, '?')

def fmt_social(c):
    ds = c.get('discord_status', '') or ''
    di = {'alive':'✓','dead':'✗','rate_limited':'⏳','error':'?'}.get(ds, '—')
    ti = '𝕏' if c.get('twitter_username') else '—'
    return f"{di}{ti}"

def fmt_url(c):
    us = c.get('url_status', '') or ''
    return {'alive':'✓','dead':'✗','error':'?'}.get(us, '—')

def fmt_contracts(c):
    contracts = c.get('contracts', [])
    if contracts:
        s = ' '.join(f"{ct['address'][:8]}..({ct['chain'][:3]})" for ct in contracts[:3])
        if len(contracts) > 3: s += f" +{len(contracts)-3}"
        return s
    return truncate(c.get('contract') or '—', 14)

# ─── Commands ────────────────────────────────────────────────────────────────

def cmd_list(args):
    """List collections with key fields."""
    c = conn()
    sql = "SELECT * FROM collections WHERE 1=1"
    params = []
    if args.query:
        sql += " AND (name LIKE ? OR contract LIKE ? OR opensea_slug LIKE ? OR creator LIKE ?)"
        p = f"%{args.query}%"
        params.extend([p, p, p, p])
    if args.tier:
        sql += " AND tier = ?"
        params.append(args.tier)
    if args.chain:
        sql += " AND chain = ?"
        params.append(args.chain)
    if args.license:
        sql += " AND license_category = ?"
        params.append(args.license)
    if args.contract:
        sql += " AND contract LIKE ?"
        params.append(f"%{args.contract}%")
    if args.discord == "none":
        sql += " AND (discord_url IS NULL OR discord_url = '')"
    elif args.discord:
        sql += " AND discord_status = ?"
        params.append(args.discord)
    if args.mint:
        sql += " AND mint_status = ?"
        params.append(args.mint)
    if args.nft_type:
        sql += " AND nft_type = ?"
        params.append(args.nft_type)
    if args.since:
        sql += " AND release_date >= ?"
        params.append(args.since)
    if args.until:
        sql += " AND release_date <= ?"
        params.append(args.until)
    if args.no_image:
        sql += " AND (image_url IS NULL OR image_url = '')"
    if args.no_supply:
        sql += " AND (total_supply IS NULL OR total_supply = '')"
    sql += " ORDER BY name"
    rows = [dict(r) for r in c.execute(sql, params)]
    for r in rows:
        r['contracts'] = [dict(ct) for ct in c.execute(
            "SELECT address, chain, is_primary FROM contracts WHERE collection_id=? ORDER BY is_primary DESC",
            (r['id'],))]
    c.close()

    if args.json:
        print(json.dumps(rows, indent=2, default=str))
        return
    if not rows:
        print("No collections found.")
        return

    # Compact table
    hdr = f"{'Collection':<32} {'T':<2} {'Released':<11} {'Chain':<9} {'L':<2} {'URL':<3} {'Soc':<3} {'Supply':<18} {'Type':<14} {'Av':<4} {'Contracts'}"
    print(hdr)
    print("-" * len(hdr))
    for c in rows:
        print(f"{truncate(c['name'],32):<32} {c['tier'] or '?':<2} {c.get('release_date') or '?':<11} "
              f"{truncate(c['chain'] or '?',9):<9} {fmt_license(c):<2} {fmt_url(c):<3} {fmt_social(c):<3} "
              f"{fmt_supply(c):<18} {fmt_nft_type(c):<14} {c.get('avatar_count') or '-':<4} {fmt_contracts(c)}")
    print(f"\n{len(rows)} collection(s)")

def cmd_show(args):
    """Show full detail for one collection."""
    if not args.query or not args.query.strip():
        print("Usage: sy show <name>  (e.g. sy show clonex)")
        return
    c = conn()
    # Try name match, then slug, then contract, then id
    row = c.execute("SELECT * FROM collections WHERE name LIKE ? ORDER BY name", (f"%{args.query}%",)).fetchone()
    if not row:
        row = c.execute("SELECT * FROM collections WHERE opensea_slug LIKE ? OR id LIKE ? OR contract LIKE ?",
                        (f"%{args.query}%", f"%{args.query}%", f"%{args.query}%")).fetchone()
    if not row:
        print(f"Not found: {args.query}")
        c.close()
        return
    r = dict(row)
    r['contracts'] = [dict(ct) for ct in c.execute(
        "SELECT * FROM contracts WHERE collection_id=? ORDER BY is_primary DESC", (r['id'],))]
    avatars = [dict(a) for a in c.execute(
        "SELECT id, name, model_file_url, format, thumbnail_url FROM avatars WHERE collection_id=? ORDER BY name LIMIT 20",
        (r['id'],))]
    avatar_count = c.execute("SELECT COUNT(*) FROM avatars WHERE collection_id=?", (r['id'],)).fetchone()[0]
    c.close()

    if args.json:
        r['avatars'] = avatars
        print(json.dumps(r, indent=2, default=str))
        return

    # Pretty print
    def kv(label, val, indent=0):
        pad = "  " * indent
        v = str(val) if val is not None and val != '' else '—'
        if len(v) > 80: v = v[:77] + '…'
        print(f"{pad}{label:<22} {v}")

    print(f"\n{'='*70}")
    print(f"  {r['name']}")
    print(f"{'='*70}")
    kv("ID", r['id'])
    kv("Tier", r['tier'])
    kv("Chain", r['chain'])
    kv("Contract", r['contract'])
    kv("OpenSea slug", r['opensea_slug'])
    kv("Release date", r.get('release_date'))
    kv("License", f"{fmt_license(r)} {r.get('vrm_license','')}")
    kv("Commercial use", r.get('commercial_use'))
    kv("Allowed user", r.get('allowed_user'))
    kv("Redistribution", r.get('redistribution'))
    kv("Creator", r.get('creator'))
    kv("Source", r.get('source'))
    kv("Project URL", r.get('project_url'))
    kv("OpenSea URL", f"https://opensea.io/collection/{r['opensea_slug']}" if r.get('opensea_slug') else '—')
    kv("Discord", r.get('discord_url'))
    kv("Discord status", f"{r.get('discord_status','')} ({r.get('discord_members',0):,} members)" if r.get('discord_status') == 'alive' else r.get('discord_status'))
    kv("Twitter", f"@{r['twitter_username']}" if r.get('twitter_username') else '—')
    kv("URL status", r.get('url_status'))
    kv("Wayback", f"{r.get('wayback_snapshots',0)} snapshots" if r.get('wayback_available') else '—')
    kv("Total supply", fmt_supply(r))
    kv("NFT type", fmt_nft_type(r))
    kv("Avg traits", r.get('avg_traits'))
    kv("Trait types", r.get('trait_types_count'))
    kv("Uniqueness", r.get('uniqueness_ratio'))
    kv("VRM param", r.get('vrm_param'))
    kv("VRM URL (HTTPS)", r.get('vrm_url_https'))
    kv("Image", r.get('image_url'))
    kv("Banner", r.get('banner_image_url'))
    kv("Sample NFT", r.get('sample_nft_name'))
    kv("Sample NFT img", r.get('sample_nft_image'))
    kv("Metadata URL", r.get('sample_metadata_url'))
    kv("Avatar count", avatar_count)
    kv("Notes", r.get('notes'))
    kv("Description", r.get('description'))
    # OpenSea API sweep fields
    print()
    kv("Unique holders", f"{r.get('num_owners',0):,}" if r.get('num_owners') else '—')
    kv("Floor price", f"{r.get('floor_price')} {r.get('floor_price_symbol','')}" if r.get('floor_price') else '—')
    kv("Total volume", f"{r.get('total_volume'):,.2f} {r.get('floor_price_symbol','')}" if r.get('total_volume') else '—')
    kv("Total sales", f"{r.get('total_sales',0):,}" if r.get('total_sales') else '—')
    kv("Category", r.get('category'))
    kv("Safelist", r.get('safelist_status'))
    kv("Owner address", r.get('owner_address'))
    kv("Royalty", f"{r.get('royalty_fee')}%" if r.get('royalty_fee') else '—')
    kv("Rarity", r.get('rarity_strategy'))
    kv("Instagram", r.get('instagram_username'))
