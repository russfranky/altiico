def cmd_audit(args):
    """Find data gaps."""
    c = conn()
    total = c.execute("SELECT COUNT(*) FROM collections").fetchone()[0]

    print(f"\n{'='*60}")
    print(f"  Data audit — missing fields")
    print(f"{'='*60}")

    # For each field, list collections missing it
    fields = [
        ('image_url', 'Image'),
        ('banner_image_url', 'Banner'),
        ('project_url', 'Project URL'),
        ('total_supply', 'Total supply'),
        ('mint_status', 'Mint status'),
        ('nft_type', 'NFT type'),
        ('release_date', 'Release date'),
        ('license_category', 'License'),
        ('creator', 'Creator'),
        ('description', 'Description'),
        ('discord_url', 'Discord'),
        ('twitter_username', 'Twitter'),
        ('contract', 'Contract'),
        ('opensea_slug', 'OpenSea slug'),
    ]

    for field, label in fields:
        missing = c.execute(
            f"SELECT name, contract, chain, source FROM collections "
            f"WHERE {field} IS NULL OR {field} = '' OR {field} = 'unknown' "
            f"ORDER BY name"
        ).fetchall()
        if not missing:
            print(f"\n  {label}: all present ✓")
            continue
        pct = len(missing) * 100 // total
        print(f"\n  {label}: {len(missing)} missing ({pct}%)")
        if len(missing) <= 15:
            for r in missing:
                ct = truncate(r['contract'] or 'NONE', 10)
                print(f"    {truncate(r['name'],28):<29} contract={ct:<10} chain={r['chain'] or '?':<10} src={r['source']}")
        else:
            for r in missing[:8]:
                ct = truncate(r['contract'] or 'NONE', 10)
                print(f"    {truncate(r['name'],28):<29} contract={ct:<10} chain={r['chain'] or '?':<10} src={r['source']}")
            print(f"    ... and {len(missing)-8} more")

    c.close()

def cmd_images(args):
    """Check for broken image URLs, optionally fix them."""
    c = conn()
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE

    def check_url(url, timeout=6):
        if not url: return 'none'
        try:
            req = urllib.request.Request(url, method='HEAD', headers={'User-Agent': 'Mozilla/5.0'})
            with urllib.request.urlopen(req, timeout=timeout, context=ctx) as r:
                ct = r.headers.get('Content-Type', '?')
                if 'image' not in ct and 'svg' not in ct:
                    return f'not-image:{ct}'
                return 'ok'
        except Exception as e:
            return f'fail:{type(e).__name__}'

    broken = []
    for table, name_col in [('collections', 'name'), ('opensea_candidates', 'slug')]:
        for field in ['image_url', 'banner_image_url']:
            for r in c.execute(f"SELECT {name_col} as name, {field} as url FROM {table} WHERE {field} IS NOT NULL AND {field} != ''"):
                s = check_url(r['url'])
                if s not in ('ok', 'none'):
                    broken.append({'table': table, 'name': r['name'], 'field': field, 'url': r['url'], 'status': s})
                    print(f"  ✗ {table}/{r['name'][:20]:21} {field:<12} {s}")
                time.sleep(0.02)

    if not broken:
        print("All images OK ✓")
        c.close()
        return

    print(f"\n{len(broken)} broken images found.")

    if args.fix:
        print("\nFixing from OpenSea API...")
        try:
            key = KEY_FILE.read_text().strip()
        except:
            print("No OpenSea API key found at ~/.opensea/api_key")
            c.close()
            return

        CHAIN_MAP = {'ethereum':'ethereum','polygon':'matic','base':'base','optimism':'optimism','shape':'shape'}
        fixed = 0
        for b in broken:
            # Get contract/slug for this row
            if b['table'] == 'collections':
                row = c.execute("SELECT contract, chain, opensea_slug FROM collections WHERE name=?", (b['name'],)).fetchone()
            else:
                row = c.execute("SELECT contract, chain, slug FROM opensea_candidates WHERE slug=?", (b['name'],)).fetchone()
            if not row:
                continue
            contract = row['contract']
            chain = CHAIN_MAP.get(row['chain'] or 'ethereum', 'ethereum')
            slug = row['opensea_slug'] if b['table'] == 'collections' else row['slug']

            # Fetch from OpenSea
            cd = None
            if slug and ' ' not in slug:
                try:
                    req = urllib.request.Request(
                        f"https://api.opensea.io/api/v2/collections/{slug}",
                        headers={"X-API-KEY": key, "User-Agent": "superyeti/1.0"})
                    with urllib.request.urlopen(req, timeout=15) as r:
                        cd = json.load(r)
                except: pass
                time.sleep(0.15)
            if not cd and contract and len(contract) >= 20:
                # Resolve slug from contract
                try:
                    req = urllib.request.Request(
                        f"https://api.opensea.io/api/v2/chain/{chain}/contract/{contract}/nfts?limit=1",
                        headers={"X-API-KEY": key, "User-Agent": "superyeti/1.0"})
                    with urllib.request.urlopen(req, timeout=15) as r:
                        nd = json.load(r)
                    if nd.get('nfts'):
                        resolved = nd['nfts'][0].get('collection', '')
                        if resolved:
                            req2 = urllib.request.Request(
                                f"https://api.opensea.io/api/v2/collections/{resolved}",
                                headers={"X-API-KEY": key, "User-Agent": "superyeti/1.0"})
                            with urllib.request.urlopen(req2, timeout=15) as r2:
                                cd = json.load(r2)
                except: pass
                time.sleep(0.15)

            if cd:
                new_url = cd.get(b['field'].replace('image_url','image_url').replace('banner_image_url','banner_image_url'), '')
                # Map field names
                if b['field'] == 'image_url':
                    new_url = cd.get('image_url', '')
                elif b['field'] == 'banner_image_url':
                    new_url = cd.get('banner_image_url', '')
                    # Skip video banners
                    if new_url and ('.mp4' in new_url.lower() or 'stream.mux.com' in new_url):
                        new_url = ''
                if new_url:
                    c.execute(f"UPDATE {b['table']} SET {b['field']}=? WHERE {name_col_for(b['table'])}=?",
                              (new_url, b['name']))
                    fixed += 1
                    print(f"  ✓ Fixed {b['name'][:25]} → {new_url[:50]}")
        c.commit()
        print(f"\nFixed {fixed}/{len(broken)}")
    c.close()

def name_col_for(table):
    return 'name' if table == 'collections' else 'slug'

def cmd_enrich(args):
    """Run enrichment scripts."""
    scripts = {
        'supply': 'check_supply.py',
        'traits': 'check_traits.py',
        'previews': 'fetch_previews.py',
        'discord': 'check_discord.py',
        'urls': 'check_opensea_urls.py',
        'vrm': 'check_vrm_v2.py',
    }
    if args.only:
        if args.only not in scripts:
            print(f"Unknown: {args.only}. Available: {', '.join(scripts)}")
            return
        run = [args.only]
    else:
        run = list(scripts.keys())

    for name in run:
        script = scripts[name]
        path = BASE / script
        if not path.exists():
            print(f"  ✗ {script} not found")
            continue
        print(f"\n{'='*50}")
        print(f"  Running {script}...")
        print(f"{'='*50}")
        result = subprocess.run([sys.executable, str(path)], cwd=str(BASE))
        if result.returncode != 0:
            print(f"  ✗ {script} failed (exit {result.returncode})")

def cmd_build(args):
    """Rebuild DB + HTML."""
    print("Rebuilding database + HTML...")
    result = subprocess.run([sys.executable, str(BASE / "build_index.py")], cwd=str(BASE))
    if result.returncode == 0 and not args.no_html:
        print("\nOpening index.html...")
        subprocess.run(['open', str(BASE / 'index.html')])

def cmd_schema(args):
    """Print DB schema."""
    c = conn()
    for table in ['collections', 'opensea_candidates', 'avatars', 'contracts']:
        print(f"\n-- {table}")
        for r in c.execute(f"PRAGMA table_info({table})"):
            print(f"  {r[1]:<28} {r[2]}")
    c.close()

def cmd_sql(args):
    """Run raw SQL, print as table."""
    c = conn()
    try:
        rows = [dict(r) for r in c.execute(args.query)]
    except Exception as e:
        print(f"SQL error: {e}")
        c.close()
        return
    c.close()
    if not rows:
        print("(no rows)")
        return
    if args.json:
        print(json.dumps(rows, indent=2, default=str))
        return
    cols = list(rows[0].keys())
    widths = {col: max(len(col), max(len(str(r.get(col,''))) for r in rows[:50])) for col in cols}
    # Cap column widths
    for col in cols:
        widths[col] = min(widths[col], 40)
    print(" | ".join(col.ljust(widths[col]) for col in cols))
    print("-+-".join("-" * widths[col] for col in cols))
    for r in rows:
        print(" | ".join(truncate(str(r.get(col,'')), widths[col]).ljust(widths[col]) for col in cols))
    print(f"\n{len(rows)} row(s)")

def cmd_db(args):
    """Open sqlite3 shell."""
    os.execvp('sqlite3', ['sqlite3', str(DB)])

# ─── Arg parsing ─────────────────────────────────────────────────────────────

def build_parser():
    p = argparse.ArgumentParser(prog='sy', description='superyeti VRM index CLI', add_help=True)
    sub = p.add_subparsers(dest='command', metavar='[command]')

    # ls / list (default)
    p_ls = sub.add_parser('ls', help='List collections')
    p_ls.add_argument('query', nargs='?', default=None)
    p_ls.add_argument('--tier', '-t', default=None, choices=['A','B','C','arweave','infra','not_vrm'])
    p_ls.add_argument('--chain', '-c', default=None, choices=['ethereum','polygon','base','optimism','arbitrum','ape_chain','shape','multi','arweave'])
    p_ls.add_argument('--license', '-l', default=None, choices=['green','yellow','red','unknown'])
    p_ls.add_argument('--contract', default=None)
    p_ls.add_argument('--discord', default=None, choices=['alive','dead','rate_limited','error','none'])
    p_ls.add_argument('--mint', default=None, choices=['capped','likely_capped','ongoing','no_max_supply','unknown'])
    p_ls.add_argument('--nft-type', '--nt', dest='nft_type', default=None, choices=['generative','1of1_series','1of1_art','numbered','no_traits','mixed','unknown'])
    p_ls.add_argument('--since', default=None)
    p_ls.add_argument('--until', default=None)
    p_ls.add_argument('--no-image', action='store_true')
    p_ls.add_argument('--no-supply', action='store_true')
    p_ls.add_argument('--json', action='store_true')

    # show
    p_show = sub.add_parser('show', help='Show full detail for one collection')
    p_show.add_argument('query')
    p_show.add_argument('--json', action='store_true')

    # find (alias for ls)
    p_find = sub.add_parser('find', help='Search/filter collections')
    p_find.add_argument('query', nargs='?', default=None)
    p_find.add_argument('--tier', '-t', default=None, choices=['A','B','C','arweave','infra','not_vrm'])
    p_find.add_argument('--chain', '-c', default=None, choices=['ethereum','polygon','base','optimism','arbitrum','ape_chain','shape','multi','arweave'])
    p_find.add_argument('--license', '-l', default=None, choices=['green','yellow','red','unknown'])
    p_find.add_argument('--contract', default=None)
    p_find.add_argument('--discord', default=None, choices=['alive','dead','rate_limited','error','none'])
    p_find.add_argument('--mint', default=None, choices=['capped','likely_capped','ongoing','no_max_supply','unknown'])
    p_find.add_argument('--nft-type', '--nt', dest='nft_type', default=None, choices=['generative','1of1_series','1of1_art','numbered','no_traits','mixed','unknown'])
    p_find.add_argument('--since', default=None)
    p_find.add_argument('--until', default=None)
    p_find.add_argument('--no-image', action='store_true')
    p_find.add_argument('--no-supply', action='store_true')
    p_find.add_argument('--json', action='store_true')

    # os
    p_os = sub.add_parser('os', help='List/search OpenSea candidates')
    p_os.add_argument('query', nargs='?', default=None)
    p_os.add_argument('--status', '-s', default=None)
    p_os.add_argument('--nft-type', '--nt', dest='nft_type', default=None)
    p_os.add_argument('--mint', default=None)
    p_os.add_argument('--no-image', action='store_true')
    p_os.add_argument('--json', action='store_true')

    # avatars
    p_av = sub.add_parser('avatars', help='Search avatars')
    p_av.add_argument('query', nargs='?', default=None)
    p_av.add_argument('--all', action='store_true')
    p_av.add_argument('--json', action='store_true')

    # stats
    p_stats = sub.add_parser('stats', help='Index statistics + data completeness')
    p_stats.add_argument('--json', action='store_true')

    # audit
    sub.add_parser('audit', help='Find missing data (gaps)')

    # images
    p_img = sub.add_parser('images', help='Check/fix broken image URLs')
    p_img.add_argument('--fix', action='store_true')

    # enrich
    p_en = sub.add_parser('enrich', help='Run enrichment scripts')
    p_en.add_argument('--only', default=None, choices=['supply','traits','previews','discord','urls','vrm'])

    # build
    p_build = sub.add_parser('build', help='Rebuild DB + HTML')
    p_build.add_argument('--no-html', action='store_true')

    # schema
    sub.add_parser('schema', help='Print DB schema')

    # sql
    p_sql = sub.add_parser('sql', help='Run raw SQL query')
    p_sql.add_argument('query')
    p_sql.add_argument('--json', action='store_true')

    # db
    sub.add_parser('db', help='Open sqlite3 shell')

    # Shortcuts (top-level flags)
    p.add_argument('-A', action='store_const', dest='shortcut', const='A')
    p.add_argument('-B', action='store_const', dest='shortcut', const='B')
    p.add_argument('-C', action='store_const', dest='shortcut', const='C')
    p.add_argument('-g', action='store_const', dest='shortcut', const='green')
    p.add_argument('-d', action='store_const', dest='shortcut', const='no-discord')
    p.add_argument('-v', action='store_const', dest='shortcut', const='generative')

    return p

def main():
    # Pre-process argv
    VALID_COMMANDS = {'ls','show','find','os','avatars','stats','audit','images','enrich','build','schema','sql','db'}
    SHORTCUT_FLAGS = {'-A','-B','-C','-g','-d','-v'}
    argv = sys.argv[1:]

    # If first arg is a shortcut flag, insert 'ls' after the shortcut flags
    if argv and argv[0] in SHORTCUT_FLAGS:
        # Find where shortcut flags end
        i = 0
        while i < len(argv) and argv[i] in SHORTCUT_FLAGS:
            i += 1
        argv = argv[:i] + ['ls'] + argv[i:]
    # If first arg isn't a known subcommand or flag, treat as `show <name>`
    elif argv and argv[0] not in VALID_COMMANDS and not argv[0].startswith('-'):
        argv = ['show'] + argv

    p = build_parser()
    args, unknown = p.parse_known_args(argv)

    # If first unknown arg looks like a collection name (not a flag), treat as `show <name>`
    if not args.command and not getattr(args, 'shortcut', None) and unknown:
        query = ' '.join(unknown)
        args.command = 'show'
        args.query = query
        args.json = False
    # Handle shortcuts: set command to ls with appropriate filter
    sc = getattr(args, 'shortcut', None)
    if sc:
        args.command = 'ls'
        # Only set defaults for attributes that don't already exist from --flags
        for attr, default in [('tier',None),('chain',None),('license',None),('contract',None),
                              ('discord',None),('mint',None),('nft_type',None),
                              ('since',None),('until',None)]:
            if not hasattr(args, attr) or getattr(args, attr) is None:
                setattr(args, attr, default)
        for attr, default in [('no_image',False),('no_supply',False),('json',False)]:
            if not hasattr(args, attr):
                setattr(args, attr, default)
        if not hasattr(args, 'query'):
            args.query = None
        if sc in ('A','B','C'):
            args.tier = sc
        elif sc == 'green':
            args.license = 'green'
        elif sc == 'no-discord':
            args.discord = 'none'
        elif sc == 'generative':
            args.nft_type = 'generative'

    # If no subcommand and no shortcut, default to ls
    if not args.command:
        args.command = 'ls'
        args.query = None
        # Ensure ls attributes exist
        for attr in ['tier','chain','license','contract','discord','mint','nft_type','since','until']:
            if not hasattr(args, attr):
                setattr(args, attr, None)
        for attr in ['no_image','no_supply','json']:
            if not hasattr(args, attr):
                setattr(args, attr, False)

    cmd = args.command or 'ls'

    if cmd == 'ls' or cmd == 'find':
        cmd_list(args)
    elif cmd == 'show':
        cmd_show(args)
    elif cmd == 'os':
        cmd_os(args)
    elif cmd == 'avatars':
        cmd_avatars(args)
    elif cmd == 'stats':
        cmd_stats(args)
    elif cmd == 'audit':
        cmd_audit(args)
    elif cmd == 'images':
        cmd_images(args)
    elif cmd == 'enrich':
        cmd_enrich(args)
    elif cmd == 'build':
        cmd_build(args)
    elif cmd == 'schema':
        cmd_schema(args)
    elif cmd == 'sql':
        cmd_sql(args)
    elif cmd == 'db':
        cmd_db(args)
    else:
        p.print_help()

if __name__ == "__main__":
    main()
